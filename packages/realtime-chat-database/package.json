{
  "name": "@wake-surfer/realtime-chat-database",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./integration-test": {
      "types": "./dist/realtime-chat-integration-test.d.ts",
      "default": "./dist/realtime-chat-integration-test.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @wake-surfer/realtime-chat-gateway-ticket build && pnpm --filter @wake-surfer/realtime-chat-message-send build && pnpm --filter @wake-surfer/realtime-chat-stream-messages build && tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@wake-surfer/realtime-chat-gateway-ticket": "workspace:*",
    "@wake-surfer/realtime-chat-message-send": "workspace:*",
    "@wake-surfer/realtime-chat-stream-messages": "workspace:*",
    "kysely": "0.28.8",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "vitest": "4.1.6"
  }
}

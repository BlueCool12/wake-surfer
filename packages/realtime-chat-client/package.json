{
  "name": "@wake-surfer/realtime-chat-client",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @wake-surfer/realtime-chat-gateway-ticket-contracts build && pnpm --filter @wake-surfer/realtime-chat-message-contracts build && pnpm --filter @wake-surfer/realtime-chat-message-mutation-contracts build && pnpm --filter @wake-surfer/realtime-chat-message-send-contracts build && pnpm --filter @wake-surfer/realtime-chat-stream-messages-contracts build && pnpm clean && tsc -p tsconfig.json",
    "clean": "node ../../scripts/manage-dual-package-output.mjs clean",
    "test": "vitest run test/realtime-chat-client.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wake-surfer/realtime-chat-message-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-message-mutation-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-message-send-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-stream-messages-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-gateway-ticket-contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

{
  "name": "@wake-surfer/realtime-chat-message-mutation-contracts",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @wake-surfer/realtime-chat-message-contracts build && node ../../scripts/manage-dual-package-output.mjs clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/manage-dual-package-output.mjs mark",
    "clean": "node ../../scripts/manage-dual-package-output.mjs clean"
  },
  "dependencies": {
    "@wake-surfer/realtime-chat-message-contracts": "workspace:*",
    "zod": "4.2.1"
  }
}

{
  "name": "@wake-surfer/realtime-chat-gateway-ticket-contracts",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/manage-dual-package-output.mjs clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node ../../scripts/manage-dual-package-output.mjs mark",
    "clean": "node ../../scripts/manage-dual-package-output.mjs clean",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.2.1"
  },
  "devDependencies": {
    "vitest": "4.1.6"
  }
}

{
  "name": "@wake-surfer/realtime-chat-message-send",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./table-contract": {
      "types": "./dist/table-contract.d.ts",
      "default": "./dist/table-contract.js"
    },
    "./persisted-message-content": {
      "types": "./dist/persisted-message-content.d.ts",
      "default": "./dist/persisted-message-content.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @wake-surfer/realtime-chat-message-send-contracts build && tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean"
  },
  "dependencies": {
    "@wake-surfer/realtime-chat-message-send-contracts": "workspace:*",
    "kysely": "0.28.8",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2"
  }
}

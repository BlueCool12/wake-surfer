{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig*.json",
    "scripts/manage-dual-package-output.mjs",
    ".env",
    ".env.*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": ["NODE_ENV", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@wake-surfer/auth-api#prisma:generate": {
      "cache": false,
      "inputs": ["prisma/**", "package.json", ".env", ".env.*"],
      "env": ["DATABASE_URL", "PRISMA_*"],
      "outputs": []
    },
    "@wake-surfer/auth-api#build": {
      "dependsOn": ["^build", "prisma:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": ["NODE_ENV", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "@wake-surfer/auth-api#typecheck": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": []
    },
    "@wake-surfer/auth-api#test": {
      "dependsOn": ["^build", "prisma:generate"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "@wake-surfer/auth-api#dev": {
      "dependsOn": ["^build", "prisma:generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    }
  }
}

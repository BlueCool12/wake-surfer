    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "vitest": "^4.1.9"
  }
}

{
  "name": "@wake-surfer/realtime-chat-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "pnpm --filter @wake-surfer/realtime-chat-contracts build && pnpm --filter @wake-surfer/realtime-chat build && tsc -p tsconfig.json",

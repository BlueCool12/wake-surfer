{
  "name": "@wake-surfer/realtime-chat-api",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/main.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@wake-surfer/api-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-database": "workspace:*",
    "@wake-surfer/realtime-chat-gateway-ticket": "workspace:*",
    "@wake-surfer/realtime-chat-gateway-ticket-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-message-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-message-mutation": "workspace:*",
    "@wake-surfer/realtime-chat-message-mutation-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-message-send": "workspace:*",
    "@wake-surfer/realtime-chat-message-send-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-stream-messages": "workspace:*",
    "@wake-surfer/realtime-chat-stream-messages-contracts": "workspace:*",
    "hono": "^4.12.28",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "esbuild": "0.28.0",
    "typescript": "~6.0.2"
  }
}

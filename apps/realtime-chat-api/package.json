{
  "name": "@wake-surfer/realtime-chat-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:deps && tsc -p tsconfig.json",
    "build:deps": "pnpm --filter @wake-surfer/api-contracts build && pnpm --filter @wake-surfer/realtime-chat-database build && pnpm --filter @wake-surfer/realtime-chat-stream-messages-contracts build && pnpm --filter @wake-surfer/realtime-chat-stream-messages build",
    "start": "node dist/main.js",
    "test": "pnpm run build:deps && vitest run",
    "typecheck": "pnpm run build:deps && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@wake-surfer/api-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-database": "workspace:*",
    "@wake-surfer/realtime-chat-gateway-ticket": "workspace:*",
    "@wake-surfer/realtime-chat-gateway-ticket-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-message-contracts": "workspace:*",
    "@wake-surfer/realtime-chat-stream-messages": "workspace:*",
    "@wake-surfer/realtime-chat-stream-messages-contracts": "workspace:*",
    "hono": "^4.12.28",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.6"
  }
}

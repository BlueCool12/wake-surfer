HOST=0.0.0.0
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
REALTIME_CHAT_BASE_PATH=/api/realtime-chat
REALTIME_CHAT_GATEWAY_ID=local-gateway
REALTIME_CHAT_GATEWAY_URL=ws://127.0.0.1:3002/ws/realtime-chat
GATEWAY_TICKET_TTL_SECONDS=60
MAX_MESSAGE_TEXT_LENGTH=4000
SYNC_DEFAULT_LIMIT=50
SYNC_MAX_LIMIT=100
REDIS_URL=redis://127.0.0.1:6379
REALTIME_CHAT_OUTBOUND_CHANNEL=realtime-chat:outbound
DATABASE_URL=

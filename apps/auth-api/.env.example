# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3002/auth/github/callback
GITHUB_SCOPES=user:email

# state 쿠키 HMAC 서명 키 (32자 이상)
#   openssl rand -base64 32
COOKIE_SECRET=

# RS256 키 쌍. 개행은 \n 으로 이스케이프해서 넣는다.
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# auth 전용 Postgres
DATABASE_URL=postgresql://wake_surfer_auth:wake_surfer_auth_dev_password@localhost:5433/wake_surfer_auth

# 로그인 후 돌아갈 프론트 주소
WEB_ORIGIN=http://localhost:5173

PORT=3002
LOG_LEVEL=info

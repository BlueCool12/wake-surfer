{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "module": "node16",
    "moduleResolution": "node16",
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": "src",
    "target": "ES2023",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
